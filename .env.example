# ClassPulse Environment Configuration Example

# Server
SERVER_PORT=8080

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/classpulse
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=classpulse
DB_USER=postgres
DB_PASSWORD=postgres

# Frontend Joining URL (used for QR code and join link generation)
FRONTEND_JOIN_URL=http://localhost:3000/join

# Teacher Authentication Secret (Minimal protected teacher MVP authorization)
TEACHER_MASTER_KEY=your-secure-teacher-master-key-here
